---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.permalink }}"
layout: layouts/base.njk
---
{% set t = i18n[lang.code] %}
{% set event = shows.upcoming %}
{% set last = shows.lastPast %}

<main>
  <div class="poster-wrap">
    {% if event %}
    <img class="poster" src="/assets/img/{{ event.poster }}" alt="{{ t.posterAlt }} {{ site.name }} — {{ event.dayMonth[lang.code] }} {{ event.year }}" />
    {% else %}
    <img class="poster" src="/assets/img/boodney-logo.jpg" alt="{{ t.logoAlt }}" />
    {% endif %}
  </div>

  <section class="info">
    <div class="title-row">
      {% if event %}
      <h1>{{ event.dayMonth[lang.code] }}<br /><span class="year">{{ event.year }}</span></h1>
      {% else %}
      <h1>{{ site.name }}</h1>
      {% endif %}
      <div class="lang" role="group" aria-label="Language">
        {% for l in languages %}
        <a href="{{ l.href }}"{% if l.code == lang.code %} class="active" aria-current="page"{% endif %} lang="{{ l.code }}" hreflang="{{ l.code }}">{{ l.label or (l.code | upper) }}</a>
        {% endfor %}
      </div>
    </div>

    {% if event %}
    <dl class="details">
      <dt>{{ t.venue }}</dt>
      <dd>
        {{ event.venue.name }}
        <span class="sub">{{ event.venue.address }}</span>
      </dd>

      <dt>{{ t.time }}</dt>
      <dd>
        {{ t.startsAt }} {{ event.startTime }}
        <span class="sub">{{ t.doorsOpen }} {{ event.doorsOpen }}</span>
      </dd>

      <dt>{{ t.repertoire }}</dt>
      <dd>
        {{ t.repertoireIntro }}
        <span class="sub">{{ event.repertoire | join(" · ") }} · {{ t.andMore }}</span>
        {% if last %}
        <button type="button" class="setlist-link" data-open-setlist>
          <span class="setlist-link-text">{{ t.setlistLink }}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </button>
        {% endif %}
      </dd>
    </dl>

    <div class="divider"></div>

    <div class="tickets">
      <div class="price-row">
        <h2>{{ t.tickets }}</h2>
        <div class="price">{{ event.price }}&thinsp;€</div>
      </div>
      <button type="button" class="order-btn" data-open-order>{{ t.orderBtn }}</button>
      <p>{{ t.paypalLine }} <a class="email-paypal" href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
      <p>{{ t.paypalNote }}</p>
      <p>{{ t.questionsLine }} <a class="email" href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
    {% else %}
    <div class="between">
      <p class="tagline">{{ t.tagline }}</p>
      <p class="next-show">{{ t.nextShow }}</p>
      <button type="button" class="order-btn subscribe-btn" data-open-order>{{ t.subscribe.btn }}</button>
      {% if last %}
      <button type="button" class="setlist-link" data-open-setlist>
        <span class="setlist-link-text">{{ t.setlistLink }}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
      {% endif %}
    </div>

    <div class="divider"></div>

    <p class="contact-line">{{ t.questionsLine }} <a class="email" href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    {% endif %}

    <div class="social">
      <a class="ig-link" href="{{ site.instagram.url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        <span>{{ site.instagram.handle }}</span>
      </a>
      <a class="ig-link" href="{{ site.tiktok.url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        </svg>
        <span>{{ site.tiktok.handle }}</span>
      </a>
    </div>
  </section>
</main>

{% if last %}
<div class="modal-backdrop" id="setlistModal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="setlistModalTitle">
  <div class="modal modal-setlist" role="document">
    <button type="button" class="modal-close" aria-label="{{ t.close }}">&times;</button>
    <h3 id="setlistModalTitle">{{ t.setlistTitle }} · {{ last.monthYear[lang.code] }}</h3>
    <p class="setlist-intro">{{ t.setlistIntro }}</p>
    <div class="setlist">
      {% for part in last.setlist.parts %}
      <div class="setlist-part">
        <h4>{{ t.setlistParts[part.id] }}</h4>
        <ol>
          {% for song in part.songs %}<li>{{ song }}</li>{% endfor %}
        </ol>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

{# With an upcoming event this is the ticket-order form; between gigs it is a
   news-subscription form reusing the same markup, order.js and Apps Script
   backend — the hidden tickets=1 input satisfies client and server validation. #}
<div class="modal-backdrop" id="orderModal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="orderModalTitle">
  <div class="modal" role="document">
    <button type="button" class="modal-close" aria-label="{{ t.close }}">&times;</button>
    <h3 id="orderModalTitle">{{ t.orderTitle if event else t.subscribe.title }}</h3>
    <form class="order-form" novalidate>
      <label class="field">
        <span class="field-label">{{ t.emailLabel }}</span>
        <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      {% if event %}
      <label class="field">
        <span class="field-label">{{ t.ticketsLabel }}</span>
        <input type="number" name="tickets" required min="1" max="10" step="1" value="1" inputmode="numeric" />
      </label>
      {% else %}
      <input type="hidden" name="tickets" value="1" />
      {% endif %}
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
      {% set notice = t.modalNotice if event else t.subscribe.notice %}
      <p class="modal-notice">{{ notice.before }}<a href="/datenschutz.html">{{ notice.link }}</a>{{ notice.after }}</p>
      <div class="modal-error" role="alert" hidden></div>
      <div class="modal-success" role="status" hidden></div>
      <div class="modal-actions">
        <button type="submit" class="modal-submit">{{ t.submitBtn if event else t.subscribe.submitBtn }}</button>
      </div>
    </form>
  </div>
</div>
